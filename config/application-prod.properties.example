# DentalCare Pro — Config esterna di produzione
# 1. Copiare come: config/application-prod.properties
# 2. Montato dal compose su /app/config e caricato da Spring (profilo prod).
#    Sovrascrive i default del classpath. Tiene le credenziali fuori dall'immagine.
#
# Punta al database dentalcare_prod sulla macchina 192.168.0.173.

# ---- Database (PostgreSQL) ----
spring.datasource.url=jdbc:postgresql://192.168.0.173:5432/dentalcare_prod
spring.datasource.username=postgres
spring.datasource.password=REPLACE_WITH_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=20000

# ---- JWT — OBBLIGATORIO ----
# Genera con: openssl rand -base64 48
# Il placeholder e' volutamente CORTO: sotto i 32 byte JJWT rifiuta la chiave e
# il backend non parte. E' voluto. Un valore di comodo lungo abbastanza da
# funzionare (com'era prima qui) parte in silenzio e firma i token con una
# chiave che sta su GitHub: chiunque l'abbia puo' forgiare un token con
# qualsiasi clinicId, schemaName e role, senza passare dal login.
app.jwt.secret=REPLACE_ME
app.jwt.expiration-ms=86400000

# ---- Demo mode ----
# In produzione TENERE false. Con enabled=true l'endpoint pubblico
# GET /api/public/demo-config restituisce email e password IN CHIARO, senza
# autenticazione, a chiunque raggiunga l'applicazione.
app.demo.enabled=false
# email/password restano valorizzate anche a demo spenta: il service account
# n8n vi ripiega (vedi sotto). Sono le credenziali con cui n8n opera sul tenant.
app.demo.email=demo@demo.dentalcare.it
app.demo.password=REPLACE_WITH_DEMO_PASSWORD

# ---- GDPR field encryption (#7) — OBBLIGATORIO ----
# Master key per cifratura per-tenant (HKDF+AES-256-GCM). Genera con:
#   openssl rand -hex 32
# Deve essere 64 caratteri esadecimali. Chiave prod DIVERSA da dev.
# ATTENZIONE: se la chiave va persa, i dati cifrati (birth_date_enc) sono
# IRRECUPERABILI. Conservala in un secret store sicuro (in futuro: Vault).
# Senza questa chiave valida il backend NON si avvia (fail-fast).
app.encryption.key-source=config
app.encryption.master-key=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ---- n8n service account ----
# Chiave che n8n presenta in X-N8N-Key su POST /api/public/service-token per
# farsi rilasciare un JWT.
app.n8n.service-key=REPLACE_WITH_N8N_SERVICE_KEY
# Utenza con cui n8n opera sul tenant. Se omesse ripiegano su
# app.demo.email/password: esplicitate qui perche' la dipendenza sia visibile e
# perche' n8n possa avere un'utenza propria invece di riusare quella demo.
app.n8n.admin-email=demo@demo.dentalcare.it
app.n8n.admin-password=REPLACE_WITH_DEMO_PASSWORD

# ---- MinIO object storage ----
app.minio.endpoint=http://host.docker.internal:9000
app.minio.access-key=REPLACE_WITH_MINIO_USER
app.minio.secret-key=REPLACE_WITH_MINIO_PASSWORD
# #40 — radice bucket per AMBIENTE: prod usa dc-prod-<schema>. Isola i documenti da
# dev (dc-dev-) e collaudo (dc-coll-) anche se uno schema tenant coincide tra ambienti.
# ATTENZIONE: cambiando questo valore su un prod esistente, i documenti già caricati
# (bucket dc-<schema>) diventano irraggiungibili finché non si esegue la migrazione
# database/scripts/migrate_minio_env_root.sh (copia dc-<schema> -> dc-prod-<schema>).
# Le due cose vanno in produzione INSIEME.
app.minio.bucket-prefix=dc-prod-

# ---- Mail (SMTP) ----
spring.mail.host=192.168.0.68
spring.mail.port=25
app.mail.from=noreply@dentalcare.it
app.mail.send-real-emails=false

# ---- Errori non esposti in produzione ----
server.error.include-message=never
server.error.include-binding-errors=never
